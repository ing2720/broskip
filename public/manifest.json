{
  "manifest_version": 3,
  "name": "broskip",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "오프닝·지난 줄거리·다음 회차 버튼이 활성화되면 대기 없이 클릭합니다.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "broskip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
