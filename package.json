{
  "name": "netflix-supporter",
  "version": "0.1.0",
  "private": true,
  "description": "A small, event-driven Netflix auto-skip Chrome extension",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
